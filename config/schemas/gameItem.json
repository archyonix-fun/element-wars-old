{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "GameItem",
  "type": "object",
  "definitions": {
    "variant": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "array"
        },
        "material": {
          "type": "string"
        },
        "texture": {
          "type": "string"
        },
        "recharge": {
          "type": "integer"
        },
        "flags": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "enum": [
                  "TOOL",
                  "WEAPON_MELEE",
                  "WEAPON_RANGE"
                ]
              }
            ]
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "id": {
      "type": "string"
    },
    "union": {
      "type": "string"
    },
    "default": {
      "$ref": "#/definitions/variant"
    },
    "variants": {
      "type": "object",
      "properties": {
        "DEFAULT": {
          "$ref": "#/definitions/variant"
        },
        "T0": {
          "$ref": "#/definitions/variant"
        },
        "T1": {
          "$ref": "#/definitions/variant"
        },
        "T2": {
          "$ref": "#/definitions/variant"
        },
        "T3": {
          "$ref": "#/definitions/variant"
        },
        "T4": {
          "$ref": "#/definitions/variant"
        }
      },
      "additionalProperties": false
    },
    "actions": {
      "patternProperties": {
        ".*": {
          "$ref": "action.json#/definitions/item"
        }
      }
    }
  },
  "required": [
    "id",
    "variants"
  ],
  "additionalProperties": false
}