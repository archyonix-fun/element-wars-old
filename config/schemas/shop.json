{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Shop",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "items": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "item",
                "icon"
              ]
            },
            "item": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "variant": {
                  "$ref": "enums/variants.json"
                }
              },
              "required": [
                "id",
                "variant"
              ],
              "additionalProperties": false
            },
            "cost": {
              "$ref": "cost.json"
            },
            "icon": {
              "type": "object",
              "properties": {
                "texture": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "dependencies": {
              "type": "array"
            },
            "actions": {
              "patternProperties": {
                ".*": {
                  "$ref": "action.json"
                }
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}