{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Walls",
  "type": "object",
  "pattern": "A-Z0-9",
  "properties": {
    "samples": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string"
            },
            "gateSettings": {
              "type": "object",
              "properties": {
                "schema": {
                  "type": "string"
                },
                "block": {
                  "type": "string"
                },
                "openingDistance": {
                  "type": "integer"
                },
                "gate": {
                  "type": "object",
                  "properties": {
                    "startPoint": {
                      "$ref": "../types/position.json"
                    },
                    "endPoint": {
                      "$ref": "../types/position.json"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "startPoint",
                    "endPoint"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "schema",
                "block",
                "gate"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "schema"
          ]
        }
      }
    },
    "directions": {
      "type": "object",
      "properties": {
        "NORTH_WEST": {
          "type": "object",
          "properties": {
            "extension": {
              "type": "string"
            },
            "sample": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "extension",
            "sample"
          ]
        },
        "NORTH": {
          "$ref": "#/properties/directions/properties/NORTH_WEST"
        },
        "EAST_NORTH": {
          "$ref": "#/properties/directions/properties/NORTH_WEST"
        },
        "EAST": {
          "$ref": "#/properties/directions/properties/NORTH_WEST"
        },
        "SOUTH_EAST": {
          "$ref": "#/properties/directions/properties/NORTH_WEST"
        },
        "SOUTH": {
          "$ref": "#/properties/directions/properties/NORTH_WEST"
        },
        "WEST_SOUTH": {
          "$ref": "#/properties/directions/properties/NORTH_WEST"
        },
        "WEST": {
          "$ref": "#/properties/directions/properties/NORTH_WEST"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": ["samples", "directions"]
}